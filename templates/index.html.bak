{% load static %}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panelka — Управление</title>
		<!-- Font Awesome -->
		<link
		  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
		  rel="stylesheet"
		/>
		<!-- Google Fonts -->
		<link
		  href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap"
		  rel="stylesheet"
		/>
		<!-- MDB -->
		<link
		  href="https://cdnjs.cloudflare.com/ajax/libs/mdb-ui-kit/9.3.0/mdb.min.css"
		  rel="stylesheet"
		/>
</head>
<body>

    <!-- Шапка (Navbar) -->
    <nav class="navbar navbar-expand-lg navbar-light bg-body-tertiary">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold text-primary" href="/">
                <i class="fas fa-server me-2"></i>PANELKA
            </a>

            <button
                data-mdb-collapse-init
                class="navbar-toggler"
                type="button"
                data-mdb-target="#navbarSupportedContent"
                aria-controls="navbarSupportedContent"
                aria-expanded="false"
                aria-label="Toggle navigation"
            >
                <i class="fas fa-bars"></i>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link active" href="/">Панель управления</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/admin/" target="_blank">Админка</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <!-- /Шапка -->

    <!-- Основной контейнер -->
    <div class="container-fluid mt-3">

        <!-- Блок вывода стандартных сообщений Django -->
        {% if messages %}
            {% for message in messages %}
                <div class="alert alert-{% if message.tags == 'error' %}danger{% else %}{{ message.tags }}{% endif %} alert-dismissible fade show" role="alert">
                    <pre class="mb-0" style="white-space: pre-wrap;">{{ message }}</pre>
                    <button type="button" class="btn-close" data-mdb-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        {% endif %}

        <!-- Колонки с кнопками из базы данных -->
        <div class="d-flex flex-wrap align-items-start bg-body-tertiary p-3 mb-3 gap-3 rounded">
            {% for category in categories %}
                <div class="col" style="min-width: 220px;">
                    <div class="mb-2 fw-bold">{{ category.name }}</div>
                    <div class="list-group list-group-light gap-2">
                        {% for script in category.scripts.all %}
                            <form method="post"
                                  action="{% url 'run_script' script.id %}"
                                  class="d-grid script-form"
                                  data-ask="{{ script.ask_input|yesno:'true,false' }}"
                                  data-prompt="{{ script.input_prompt }}">
                                {% csrf_token %}
                                <button type="submit" class="btn btn-success" data-mdb-ripple-init>
                                    {{ script.title }}
                                </button>
                            </form>
                        {% empty %}
                            <span class="text-muted small">Кнопок пока нет</span>
                        {% endfor %}
                    </div>
                </div>
            {% empty %}
                <p class="text-muted mb-0">
                    Колонок пока нет. Добавьте их в <a href="/admin/" target="_blank">админке Django</a>.
                </p>
            {% endfor %}
        </div>

        <!-- Панель управления запущенными screen-проектами на VPS -->
        <div class="mx-auto mt-3" style="max-width: 900px;">
            <div class="card border shadow-1">
                <div class="card-body py-2 px-3 d-flex flex-wrap align-items-center gap-2">
                    <button type="button" id="btn-load-screens" class="btn btn-primary btn-sm" data-mdb-ripple-init>
                        <i class="fas fa-layer-group me-1"></i> Проекты в screen
                    </button>

                    <!-- Выпадающий список найденных сессий -->
                    <select id="screen-select" class="form-select form-select-sm" style="width: auto; min-width: 220px; display: none;"></select>

                    <!-- Кнопки действий с выбранной сессией -->
                    <div id="screen-actions" class="btn-group btn-group-sm" style="display: none;">
                        <button type="button" class="btn btn-info" onclick="runScreenAction('logs')">
                            <i class="fas fa-eye me-1"></i> Консоль
                        </button>
                        <button type="button" class="btn btn-warning" onclick="runScreenAction('restart')">
                            <i class="fas fa-rotate-right me-1"></i> Рестарт
                        </button>
                        <button type="button" class="btn btn-danger" onclick="runScreenAction('stop')">
                            <i class="fas fa-stop me-1"></i> Остановить
                        </button>
                    </div>

                    <span id="screen-status" class="small text-muted ms-2"></span>
                </div>
            </div>
        </div>

        <!-- Панель выбора скачанного проекта, загрузки .env и запуска -->
        <div class="mx-auto mt-3" style="max-width: 900px;">
            <div class="card border shadow-1">
                <div class="card-body py-2 px-3 d-flex flex-wrap align-items-center gap-2">
                    <button type="button" id="btn-load-projects" class="btn btn-secondary btn-sm" data-mdb-ripple-init>
                        <i class="fas fa-folder-open me-1"></i> Скачанные проекты VPS
                    </button>

                    <!-- Выпадающий список папок из /root/projects -->
                    <select id="project-select" class="form-select form-select-sm" style="width: auto; min-width: 200px; display: none;"></select>

                    <!-- Скрытый input для выбора .env файла с компьютера -->
                    <input type="file" id="env-file-input" style="display: none;" />

                    <!-- Кнопки запуска после выбора проекта -->
                    <div id="deploy-actions" class="btn-group btn-group-sm" style="display: none;">
                        <button type="button" class="btn btn-success" onclick="document.getElementById('env-file-input').click()">
                            <i class="fas fa-file-import me-1"></i> Выбрать .env и запустить
                        </button>
                        <button type="button" class="btn btn-outline-success" onclick="startProjectDeploy(null)">
                            Запустить без .env
                        </button>
                    </div>

                    <span id="project-status" class="small text-muted ms-2"></span>
                </div>
            </div>
        </div>


        <!-- Встроенное окно живого терминала (по центру под кнопками) -->
        <div id="terminal-box" class="mx-auto mt-3" style="display: none; max-width: 900px;">
            <div class="card shadow-3 border border-secondary" style="background-color: #1e1e1e; color: #00ff66;">
                <div class="card-header d-flex justify-content-between align-items-center py-2 px-3" style="background-color: #2d2d2d; border-bottom: 1px solid #444;">
                    <span class="small fw-bold text-light">
                        <i class="fas fa-terminal me-2 text-success"></i>Консоль выполнения VPS
                    </span>
                    <div>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 me-1 text-light" onclick="document.getElementById('terminal-output').textContent=''">
                            Очистить
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-light py-1 px-2" onclick="document.getElementById('terminal-box').style.display='none'">
                            ✕ Закрыть
                        </button>
                    </div>
                </div>
                <div class="card-body p-3">
                    <pre id="terminal-output" class="mb-0" style="height: 320px; overflow-y: auto; font-family: Consolas, monospace; font-size: 0.85rem; white-space: pre-wrap; color: #00ff66;"></pre>
                </div>
            </div>
        </div>

    </div>
    <!-- /Основной контейнер -->

    <!-- Скрипты управления кнопками, screen-сессиями и живым выводом -->
    <script>
        // 1. Запуск обычных и интерактивных кнопок (локальных и VPS)
        document.querySelectorAll('.script-form').forEach(form => {
            form.addEventListener('submit', async function(e) {
                e.preventDefault();

                const formData = new FormData(form);

                if (form.dataset.ask === 'true') {
                    const userValue = prompt(form.dataset.prompt || 'Введите параметр:');
                    if (userValue === null || userValue.trim() === '') {
                        return;
                    }
                    formData.append('user_input', userValue.trim());
                }

                const box = document.getElementById('terminal-box');
                const output = document.getElementById('terminal-output');
                const btn = form.querySelector('button');

                box.style.display = 'block';
                output.textContent = 'Запуск задачи...\n';
                btn.disabled = true;

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: formData
                    });

                    const reader = response.body.getReader();
                    const decoder = new TextDecoder('utf-8');

                    while (true) {
                        const { done, value } = await reader.read();
                        if (done) break;
                        output.textContent += decoder.decode(value, { stream: true });
                        output.scrollTop = output.scrollHeight;
                    }
                } catch (err) {
                    output.textContent += `\nОшибка сети: ${err}`;
                } finally {
                    btn.disabled = false;
                }
            });
        });
        // 2. Загрузка списка проектов в screen
// 4. Загрузка списка скачанных проектов в /root/projects на VPS
document.getElementById('btn-load-projects').addEventListener('click', async function() {
    const btn = this;
    const select = document.getElementById('project-select');
    const actions = document.getElementById('deploy-actions');
    const status = document.getElementById('project-status');

    btn.disabled = true;
    status.textContent = 'Читаю /root/projects...';
    select.style.display = 'none';
    actions.style.display = 'none';

    try {
        const res = await fetch("{% url 'vps_projects_list' %}");
        const data = await res.json();

        if (data.error) {
            status.textContent = data.error;
            return;
        }

        if (!data.projects || data.projects.length === 0) {
            status.textContent = 'В /root/projects пока нет скачанных папок.';
            return;
        }

        select.innerHTML = '';
        data.projects.forEach(name => {
            const opt = document.createElement('option');
            opt.value = name;
            opt.textContent = name;
            select.appendChild(opt);
        });

        status.textContent = `Проектов: ${data.projects.length}`;
        select.style.display = 'inline-block';
        actions.style.display = 'inline-flex';
    } catch (e) {
        status.textContent = 'Ошибка запроса к серверу';
    } finally {
        btn.disabled = false;
    }
});

// Когда пользователь выбрал .env файл в Проводнике — сразу запускаем деплой
document.getElementById('env-file-input').addEventListener('change', function() {
    if (this.files && this.files.length > 0) {
        startProjectDeploy(this.files);
        this.value = ''; // Сбрасываем input, чтобы можно было выбрать тот же файл повторно
    }
});

// Отправка .env и запуск установки в screen
async function startProjectDeploy(fileObj) {
    const select = document.getElementById('project-select');
    const projectName = select.value;
    if (!projectName) return;

    const box = document.getElementById('terminal-box');
    const output = document.getElementById('terminal-output');
    box.style.display = 'block';
    output.textContent = `>>> Начинаю развёртывание проекта "${projectName}"...\n\n`;

    const formData = new FormData();
    formData.append('csrfmiddlewaretoken', '{{ csrf_token }}');
    formData.append('project_name', projectName);
    if (fileObj) {
        formData.append('env_file', fileObj);
    }

    try {
        const response = await fetch("{% url 'deploy_with_env' %}", {
            method: 'POST',
            body: formData
        });
        const reader = response.body.getReader();
        const decoder = new TextDecoder('utf-8');

        while (true) {
            const { done, value } = await reader.read();
            if (done) break;
            output.textContent += decoder.decode(value, { stream: true });
            output.scrollTop = output.scrollHeight;
        }
    } catch (err) {
        output.textContent += `\nОшибка сети: ${err}`;
    }
}


        // 3. Действия с выбранным screen-проектом (Консоль / Рестарт / Остановить)
        async function runScreenAction(action) {
            const select = document.getElementById('screen-select');
            const selectedOption = select.options[select.selectedIndex];
            if (!selectedOption) return;

            const box = document.getElementById('terminal-box');
            const output = document.getElementById('terminal-output');
            box.style.display = 'block';
            output.textContent = `>>> Выполняю [${action}] для ${selectedOption.dataset.name}...\n\n`;

            const formData = new FormData();
            formData.append('csrfmiddlewaretoken', '{{ csrf_token }}');
            formData.append('session_id', selectedOption.value);
            formData.append('session_name', selectedOption.dataset.name);
            formData.append('action', action);

            try {
                const response = await fetch("{% url 'screen_action' %}", {
                    method: 'POST',
                    body: formData
                });
                const reader = response.body.getReader();
                const decoder = new TextDecoder('utf-8');

                while (true) {
                    const { done, value } = await reader.read();
                    if (done) break;
                    output.textContent += decoder.decode(value, { stream: true });
                    output.scrollTop = output.scrollHeight;
                }

                if (action === 'stop') {
                    document.getElementById('btn-load-screens').click();
                }
            } catch (err) {
                output.textContent += `\nОшибка сети: ${err}`;
            }
        }

    </script>

    <!-- Локальный MDB JS -->
    <script src="{% static 'js/mdb.umd.min.js' %}"></script>
    <!-- MDB -->
	<script
	  type="text/javascript"
	  src="https://cdnjs.cloudflare.com/ajax/libs/mdb-ui-kit/9.3.0/mdb.umd.min.js"
	></script>
</body>
</html>
